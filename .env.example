# =============================================================================
# PEMF Backend — ORTAM DEĞİŞKENLERİ örneği (audit B-11.1)
# -----------------------------------------------------------------------------
# Uygulamanın GERÇEKTE okuduğu PEMF_* değişkenleri. Üretim kurulumu bunları
# `deploy/device.env` | `deploy/server.env` | `deploy/staging.env` profillerinden
# NSSM'e yazar (setup_services.ps1 -Mode ...). Bu dosya ELLE/dev çalıştırma referansıdır.
# (Eski MQTT_CLOUD_USER/PASS KALDIRILDI — HiveMQ bulut MQTT bırakıldı; yerel-only.)
# =============================================================================

# ── Servis / API ──
PEMF_HEADLESS=1
PEMF_API_HOST=0.0.0.0            # server profilinde 127.0.0.1 (reverse-proxy arkası)
PEMF_API_PORT=8000
PEMF_LOG_LEVEL=INFO
PEMF_LOG_DIR=                    # boş → <app_data>/logs
PEMF_LOG_JSON=0                  # 1 → yapısal JSON log (audit B-5.2)

# ── Veri / şifreleme (KVKK) ──
PEMF_DATA_DIR=                   # boş → %APPDATA%\PEMF_GUI ; üretimde C:\ProgramData\PEMF_System
PEMF_ENCRYPT_AT_REST=0           # 1 → hasta+tedavi DB SQLCipher (üretimde 1; sqlcipher3 wheel şart)
PEMF_BACKUP_DIR=                 # ayarlanırsa günlük yedekler buraya da (off-machine, audit B-7.2)

# ── Güvenlik / uzaktan erişim ──
PEMF_REQUIRE_AUTH=0              # 1 → X-API-Key zorunlu (tünel açılınca OTOMATİK 1'e zorlanır)
PEMF_API_TOKEN=                  # boş → app_data'da otomatik üretilir
PEMF_CORS_ORIGINS=*              # üretimde kendi web origin'lerinizle daraltın
PEMF_ENABLE_TUNNEL=0             # 1 → Cloudflare tünel (cloudflared bundle şart)
PEMF_CLOUDFLARE_TUNNEL_TOKEN=    # NAMED tünel (kalıcı hostname); boş → QUICK tünel
PEMF_TUNNEL_HOSTNAME=
PEMF_RATELIMIT_REMOTE_PER_MIN=600  # uzak-IP dakikalık limit (audit B-1.6); 0 = kapalı
PEMF_ENABLE_DOCS=                # 1/0 → Swagger'ı zorla aç/kapat (vars: prod'da kapalı, audit B-1.7)

# ── Donanım ──
PEMF_STM_PORT=auto               # 'auto' = ST-Link VCP oto-algıla; ya da COM7
PEMF_SIMULATE=0                  # 1 → donanımsız sanal STM+ESP+sensör (server/staging)
PEMF_MQTT_USER=                  # broker allow_anonymous=false ise
PEMF_MQTT_PASS=

# ── Bulut / gözlemlenebilirlik (opsiyonel) ──
SUPABASE_URL=                    # boş → gömülü varsayılan (publishable/anon)
SUPABASE_KEY=
PEMF_CLOUD_PATIENT_SYNC=0        # PII bulut-sync (KVKK — varsayılan kapalı)
PEMF_SENTRY_DSN=                 # ayarlanırsa uzaktan hata-izleme (opt-in, PII-scrub, audit B-5.1)
PEMF_DEVICE_NAME=PEMF-Vet
