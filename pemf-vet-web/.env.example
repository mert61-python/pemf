# PEMF Vet Web — ortam değişkenleri (Vercel → Project → Settings → Environment Variables)
# Client (VITE_*) tarayıcıya gömülür — YALNIZ public anahtarlar. Diğerleri sunucu-only (serverless).

# ── Client (tarayıcı) — Supabase giriş (public, hazır) ──────────────────────
VITE_SUPABASE_URL=https://wmsxonunkphjeregpvuj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_D2SaRML_PIhRtr3kqlXxaw_1cS75GKT

# ── Sunucu (serverless /api) — Supabase ─────────────────────────────────────
SUPABASE_URL=https://wmsxonunkphjeregpvuj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_D2SaRML_PIhRtr3kqlXxaw_1cS75GKT
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx     # Supabase → Settings → API → service_role (GİZLİ)

# ── Sunucu (serverless /api) — iyzico ───────────────────────────────────────
IYZICO_API_KEY=sandbox-xxx                  # iyzico → Ayarlar → API Anahtarları
IYZICO_SECRET_KEY=sandbox-xxx
IYZICO_MERCHANT_ID=xxxxxxx                  # webhook imza doğrulaması için (Üye İşyeri No)
IYZICO_URI=https://sandbox-api.iyzipay.com  # PROD: https://api.iyzipay.com

# Plan referans kodları — iyzico panelinde Ürün → Ödeme Planı oluşturunca çıkar (8 kombinasyon)
IYZICO_PLAN_PRO_MONTHLY=xxx
IYZICO_PLAN_PRO_YEARLY=xxx
IYZICO_PLAN_PROPLUS_MONTHLY=xxx
IYZICO_PLAN_PROPLUS_YEARLY=xxx
IYZICO_PLAN_PRO_RESEARCH_MONTHLY=xxx        # Pro + Araştırma dahil plan
IYZICO_PLAN_PRO_RESEARCH_YEARLY=xxx
IYZICO_PLAN_PROPLUS_RESEARCH_MONTHLY=xxx
IYZICO_PLAN_PROPLUS_RESEARCH_YEARLY=xxx

# Webhook imza şeması sürümlenebildiğinden varsayılan gevşek (imza tutmazsa re-fetch ile işler).
# Sandbox'ta imza doğrulandıktan sonra 1 yapıp sıkılaştırın:
# IYZICO_WEBHOOK_STRICT=1

# Opsiyonel: callback/success için sabit site URL'i (yoksa istek origin'i kullanılır)
# PUBLIC_SITE_URL=https://pemf-vet-web.vercel.app
