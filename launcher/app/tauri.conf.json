{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEMF Vet Client",
  "version": "1.9.0",
  "identifier": "com.pemfmedical.vetclient",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "PEMF Vet Client",
        "width": 720,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "PEMF Medical Technologies",
    "category": "Utility",
    "shortDescription": "PEMF Vet Client kurulum ve başlatma",
    "longDescription": "PEMF Vet uygulamasını indirir, SHA256 ile doğrular, kurar ve backend'i başlatır.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgl1",
          "libglib2.0-0"
        ]
      },
      "rpm": {
        "depends": [
          "mesa-libGL",
          "glib2"
        ]
      }
    }
  }
}
