{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PEMF Vet Client",
  "version": "1.3.7",
  "identifier": "com.vpemf.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PEMF Vet",
        "width": 1000,
        "height": 680,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": ["mosquitto"],
        "postInstallScript": "scripts/deb-postinst.sh",
        "postRemoveScript": "scripts/deb-postrm.sh"
      },
      "rpm": {
        "depends": ["mosquitto"],
        "postInstallScript": "scripts/deb-postinst.sh",
        "postRemoveScript": "scripts/deb-postrm.sh"
      }
    }
  }
}
