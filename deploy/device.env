# =============================================================================
# PEMF Backend — KLİNİK profili (device.env)
# =============================================================================
# Gerçek donanımlı klinik PC'si (STM32 COM + ESP MQTT). Uzaktan erişim AÇIK.
# Kurulum:  setup_services.ps1 -Mode device     (env'leri NSSM'e bu dosyadan yazar)
# NOT: KEY=VALUE satırları; '#' yorum; boş satır yok sayılır.
# =============================================================================

PEMF_HEADLESS=1
PEMF_API_HOST=0.0.0.0
PEMF_API_PORT=8000

# STM32 portu: 'auto' = ST-Link VCP'yi USB PID/açıklama ile tanır, onboard STM'i eler.
# DİKKAT: boş bırakılırsa kod oto-algılama YAPMAZ → sabit COM10'a düşer (yanlış port riski).
# Bu yüzden 'auto' AÇIKÇA veriliyor; tutmazsa elle sabitleyin: PEMF_STM_PORT=COM7
PEMF_STM_PORT=auto

# Uzaktan erişim (farklı WiFi'den kod/pairing ile) — kullanıcı tercihi: AÇIK.
# Tünel internete açtığı için auth ZORUNLU (kimliksiz kontrol engellenir).
# cloudflared.exe bin\cloudflared\ altında BUNDLE edilmeli (offline saha).
PEMF_ENABLE_TUNNEL=1
PEMF_REQUIRE_AUTH=1

# ÜRETİM ÖNERİSİ (P1): QUICK tünel (trycloudflare) URL'si her restart DEĞİŞİR + SLA yok.
# Tıbbi cihaz için Cloudflare'de NAMED tünel oluşturup token + KALICI hostname verin
# (boşsa QUICK tünele düşer). Kurulum: cloudflared tunnel create + DNS CNAME + token.
# PEMF_CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
# PEMF_TUNNEL_HOSTNAME=cihaz1.klinikdomaininiz.com

# CORS (SEC-1): app HEP same-origin çağırır (config.ts window.location.origin) → meşru cross-origin
# tarayıcı-istemci YOK. '*' = LAN'daki kötücül sayfa /api/auth/token'ı fetch'leyip token'ı OKUYABİLİR
# (CORS=* yanıtı okumaya izin verir) → cihaz ele geçirme. Same-origin CORS'a takılmaz → daraltmak
# app'i BOZMAZ (web=localhost/LAN-IP/tünel hepsi kendi origin'i; mobil=native, CORS yok).
PEMF_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# DNS-rebinding korumasi (2026-08-22): 'auto' = IP-literal/localhost/*.local/makine-adi/
# tunel alanlari serbest, YABANCI alan adlari 400. Kurumsal intranet FQDN'i varsa:
# PEMF_ALLOWED_HOSTS=auto,klinik.sirket.com  ·  Kapatmak icin: PEMF_ALLOWED_HOSTS=*
PEMF_ALLOWED_HOSTS=auto

# Rate limit (audit B-1.6): YALNIZ uzak (tünel) istekler için IP-başı dakikalık üst sınır
# (DoS/tarama azaltma; LAN sınırsız, acil-durdur/health/discovery muaf). 0 = kapalı.
# AI Pro'yu uzaktan yoğun kullanıyorsanız yükseltin. Varsayılan 600.
PEMF_RATELIMIT_REMOTE_PER_MIN=600

# Hasta verisi (PII) buluta GİTMEZ (KVKK) — yalnız local şifreli SQLite.
PEMF_CLOUD_PATIENT_SYNC=0

# At-rest ŞİFRELEME (KVKK — P0 audit 2026-06-28): hasta (patient_database) + tedavi
# (treatment_history) DB'leri SQLCipher ile ŞİFRELENSİN. Anahtar Windows Credential
# Manager'da (keyring) saklanır → ANAHTAR/keyring KAYBOLURSA şifreli veri OKUNAMAZ
# (kurulumda yedekleyin). Doğrula: /api/health → atRestEncrypted=true.
PEMF_ENCRYPT_AT_REST=1

# Bu klinik için ayırt edici ad (devices registry'de görünür).
PEMF_DEVICE_NAME=PEMF-Klinik-01

PEMF_LOG_DIR=C:\ProgramData\PEMF_System\logs

# Veri kökü (hasta/tedavi DB + SQLCipher anahtar DOSYASI + device_id). Servis LocalSystem'de
# APPDATA = ...\systemprofile\... (operatöre görünmez/yedeklenemez) → ProgramData'ya sabitle.
# Anahtar dosyası buraya (PEMF_GUI\.sqlcipher_key) yazılır; YEDEKLEYİN (kaybı = veri kaybı).
PEMF_DATA_DIR=C:\ProgramData\PEMF_System

# OFF-MACHINE YEDEK (audit B-7.2): ayarlanırsa günlük şifreli DB yedekleri (hasta+tedavi) buraya da
# kopyalanır → disk arızası/ransomware'de tek-nokta olmasın. Ağ paylaşımı/USB önerilir. Boşsa yalnız
# yerel backups/ klasörü (aynı disk). Örn: PEMF_BACKUP_DIR=\\NAS\pemf-yedek  veya  E:\PEMF_Yedek
# PEMF_BACKUP_DIR=

# MQTT (ESP bobin 6-8) broker kimliği — üretimde SET EDİN + allow_anonymous=false.
# PEMF_MQTT_USER=pemf
# PEMF_MQTT_PASS=DEGISTIRIN
