# =============================================================================
# PEMF Backend — STAGING profili (staging.env)  [audit B-9.4]
# =============================================================================
# ÜRETİM-BENZERİ doğrulama ortamı: bir release'i GERÇEK klinik cihazına deploy ETMEDEN önce
# sınamak için. Donanımsız (SİMÜLASYON) ama üretim güvenlik ayarları AÇIK; AYRI kimlik/veri-kökü/
# log/port → aynı makinedeki device/server instance'ıyla ÇAKIŞMAZ. QA/CI veya ayrı bir makinede koşar.
# Kurulum:  setup_services.ps1 -Mode staging
# =============================================================================

PEMF_HEADLESS=1

# Donanım YOK → simüle (gerçek STM/ESP'ye DOKUNMAZ; süre-watchdog/interlock gibi güvenlik yollarını
# üretimdeki gibi çalıştırır → davranış doğrulanır).
PEMF_SIMULATE=1

# ÜRETİM-BENZERİ güvenlik: auth + at-rest şifreleme AÇIK (prod davranışını sınamak için).
PEMF_REQUIRE_AUTH=1
PEMF_ENCRYPT_AT_REST=1

# AYRI port → aynı makinede device (8000) veya server ile çakışmasın.
PEMF_API_HOST=0.0.0.0
PEMF_API_PORT=8010

# Tünel KAPALI (staging'i internete açma; gerekirse NAMED tünelle ayrıca test et).
PEMF_ENABLE_TUNNEL=0

# CORS: staging web origin'iniz (kendi staging domain'inizle değiştirin).
# Audit P3: '*' VARSAYILANI kötü LAN-sayfasına token-hırsızlığı/cross-origin okuma izni verir → ASLA '*'
# bırakma. Same-origin app zaten CORS'a takılmaz; kendi staging domain'inizi yazın.
PEMF_CORS_ORIGINS=https://staging.ornekdomain.com

# DNS-rebinding korumasi (2026-08-22): 'auto' = IP-literal/localhost/*.local/makine-adi/
# tunel alanlari serbest, YABANCI alan adlari 400. Kurumsal intranet FQDN'i varsa:
# PEMF_ALLOWED_HOSTS=auto,klinik.sirket.com  ·  Kapatmak icin: PEMF_ALLOWED_HOSTS=*
PEMF_ALLOWED_HOSTS=auto

# Demo/sahte veri; PII bulut-sync kapalı.
PEMF_CLOUD_PATIENT_SYNC=0

# Ayırt edici ad + AYRI veri/log kökü (gerçek device/klinik verisiyle KARIŞMASIN).
PEMF_DEVICE_NAME=PEMF-Staging
PEMF_DATA_DIR=C:\ProgramData\PEMF_Staging
PEMF_LOG_DIR=C:\ProgramData\PEMF_Staging\logs

# Gözlemlenebilirlik (audit B-5.2): staging'de JSON structured log AÇIK (toplama/sorgulamayı sına).
PEMF_LOG_JSON=1

# Rate-limit üretim-benzeri (uzak sınama).
PEMF_RATELIMIT_REMOTE_PER_MIN=600

# Opsiyonel: staging'de Sentry telemetriyi test etmek için DSN verin (varsayılan kapalı, KVKK).
# PEMF_SENTRY_DSN=https://<key>@<host>/<project>
