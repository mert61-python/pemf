# =============================================================================
# PEMF Backend — SUNUCU profili (server.env)
# =============================================================================
# Donanımsız 7/24 DEMO/SİMÜLASYON instance'ı. Public internet + reverse-proxy(TLS).
# Kurulum:  setup_services.ps1 -Mode server      (Mosquitto KURMA — donanım yok)
# =============================================================================

PEMF_HEADLESS=1

# Donanım YOK → tüm bobinler/sensörler SİMÜLE. (Aksi halde STM sürekli reconnect dener.)
PEMF_SIMULATE=1

# Reverse-proxy (IIS/Nginx/Caddy) TLS sonlandırır → backend yalnız localhost dinler.
# Dışarıya yalnız 443 (proxy) açık olsun; 8000 sadece localhost.
PEMF_API_HOST=127.0.0.1
PEMF_API_PORT=8000

# Public erişim → kimlik doğrulama ZORUNLU (token'sız 401). Token api_token.txt'den
# otomatik üretilir; yetkili istemcilere güvenli kanaldan dağıtın.
PEMF_REQUIRE_AUTH=1

# CORS: yalnız KENDİ web origin'leriniz (asla '*'). Kendi domain'inizle değiştirin.
PEMF_CORS_ORIGINS=https://app.ornekdomain.com

# Public host zaten erişilebilir → Cloudflare tüneli GEREKSİZ.
PEMF_ENABLE_TUNNEL=0

# Demo veride PII yok; bulut sync kapalı.
PEMF_CLOUD_PATIENT_SYNC=0

PEMF_DEVICE_NAME=PEMF-Demo-Server

# Public sunucuda DB şifreleme önerilir. NOT: frozen EXE'de sqlcipher binding GÖMÜLÜ
# değilse düz-metne sessiz fallback olur → /api/health 'atRestEncrypted' ile DOĞRULAYIN.
PEMF_ENCRYPT_AT_REST=1

PEMF_LOG_DIR=C:\ProgramData\PEMF_System\logs
