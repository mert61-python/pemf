# =============================================================================
# PEMF Docker — OPSİYONEL konfigürasyon override'ları.
# docker-compose.yml zaten güvenli varsayılanlarla çalışır; bu dosya sadece
# değer değiştirmek istersen gerekir:
#     cp docker.env.example .env      (Windows: copy docker.env.example .env)
# `docker compose` proje kökündeki `.env` dosyasını OTOMATİK okur.
# (Not: uygulamanın kendi .env.example'ı AYRIDIR — o Windows/NSSM profilleri içindir.)
# =============================================================================

# ── Portlar (host tarafı) ──
PEMF_WEB_PORT=8080          # tarayıcı arayüzü  → http://localhost:8080
PEMF_API_PORT=8000          # doğrudan API/debug → http://localhost:8000/api/health

# ── Backend davranışı ──
PEMF_SIMULATE=1             # 1=donanımsız simülasyon (Docker için ZORUNLU). Docker'da 0 YAPMA.
PEMF_REQUIRE_AUTH=1         # 1=API token ister (önerilen), 0=açık (yalnız yerel test)
PEMF_DEVICE_NAME=PEMF-Docker

# ── AI modelleri (host yolu → konteynerde /models, salt-okunur) ──
PEMF_MODELS_DIR=./release_assets/ai_models   # modeller başka yerdeyse mutlak yol ver
