# syntax=docker/dockerfile:1
# =============================================================================
# PEMF AI Servisi (GPU) — mikroservis (Faz 2a).
# CUDA 12.8 + cuDNN 9 runtime (RTX 5090/Blackwell sm_120); torch cu128 → onnxruntime-gpu 1.19 ile GPU inference.
# GERÇEK uçlar: /infer/histopath (görüntü), /infer/sound (ses).
# ⚠️ DENETİM 2026-08-04: burada eskiden "torch YOK (saf-ONNX)" yazıyordu — YANLIŞ. Aşağıdaki
# RUN adımı torch 2.7.1 + torchvision 0.22.1 KURAR ve bu ZORUNLUDUR: `ai_service/app.py` ile
# `gpu.py` doğrudan `import torch` yapar, ultralytics de import anında torch ister, ayrıca
# histopath ve cat_sound predictor'ları torch kullanır. Yorumu okuyup "gereksiz" diye kaldıran
# biri servisi tamamen bozar. (torch ~2 GB imaj ağırlığının ve CVE yüzeyinin de kaynağıdır.)
# Çalıştırma GPU ister:  compose'da deploy.resources / docker run --gpus all
# =============================================================================
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

LABEL org.opencontainers.image.title="PEMF Vet AI Service" \
      org.opencontainers.image.description="PEMF AI mikroservis — GPU/CUDA onnxruntime inference" \
      org.opencontainers.image.licenses="Proprietary"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PEMF_AI_MODELS_DIR=/models \
    NUMBA_CACHE_DIR=/tmp/numba \
    MPLCONFIGDIR=/tmp/mpl

# python3.10 (ubuntu22.04 hazır) + ffmpeg (ses→wav, librosa) + libsndfile (soundfile)
# + libgomp (numba/openmp) + libgl/glib (opencv cv2)
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip ffmpeg libsndfile1 libgomp1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ai_service/requirements-ai.txt ./ai_service/requirements-ai.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128 \
 && pip3 install -r ai_service/requirements-ai.txt

# ai_hub = predictor KODU (ağırlıklar .dockerignore ile hariç → /models mount'tan gelir)
# DENETİM 2026-08-04 (P3): önce `COPY` + sonra `chown -R /app` yapılıyordu; bu, /app'in
# TAMAMINI ikinci bir katmana kopyalayıp imajı boşuna ~67 MB büyütüyordu. Kullanıcı COPY'lerden
# ÖNCE oluşturulup COPY'ler `--chown` ile yapılıyor → ekstra katman yok.
RUN groupadd -r pemfai && useradd -r -g pemfai -d /home/pemfai -m pemfai

COPY --chown=pemfai:pemfai ai_hub/ ./ai_hub/
COPY --chown=pemfai:pemfai ai_service/ ./ai_service/

# ⚠️ DENETİM 2026-08-04: bu imaj ROOT olarak koşuyordu — kardeşi Dockerfile.backend'de
# `USER pemf` varken burada hiç USER yoktu. Servis `/infer/...` uçlarında AUTH'suz olarak
# kullanıcı yüklemesi (görüntü/ses) işler; bu yol ffmpeg, libsndfile, opencv, pillow ve
# ONNX çözücülerine kadar iner. Oralardaki bir bellek-bozma hatası root konteynerde çok daha
# değerli bir sonuç verir. Ayrıcalık gerekmiyor: /models salt-okunur mount, önbellek dizinleri
# zaten /tmp altında (NUMBA_CACHE_DIR / MPLCONFIGDIR), yazılan başka yer yok.
EXPOSE 8100

# Sağlık yoklaması: compose/orchestrator servisin GERÇEKTEN hazır olduğunu bilsin (model
# yükleme uzun sürer; port açık ≠ hazır). curl kurmamak için python3 kullanılıyor.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3     CMD python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/health', timeout=4).status==200 else 1)"

USER pemfai
CMD ["python3", "-m", "uvicorn", "ai_service.app:app", "--host", "0.0.0.0", "--port", "8100"]
