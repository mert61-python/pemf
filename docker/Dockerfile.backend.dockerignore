.env.*
docker/.env
docker/.env.*
docker/docker.env.example
deploy/*.env

# Audit P1: GERÇEK sırlar image'a GİRMESİN — düz-metin MQTT/WiFi parolaları + credential dosyaları
# + at-rest anahtarları. Runtime'da volume/secret ile enjekte edilmeli (COPY . . bunları gömüyordu).
config/credentials/
config/config.json
data/config.json
*.pemf_key
.pemf_key
.pemf_key_v2
.sqlcipher_key
pemf_secrets.json
pemf_secret.key

# Audit P1: Apple kod-imzalama özel anahtarları + sertifikalar image/context'e ASLA girmesin
*.p8
*.p12
*.pfx
*.key
*.pem
*.cer
AuthKey_*.p8
apple-mac-cert/
_p12_pw.txt

# Docker config dosyaları (hepsi docker/ altında toplandı) — image'a girmesin.
# ⚠️ docker/requirements-docker.txt HARİÇ TUTULMAZ — Dockerfile.backend onu COPY'liyor.
docker/*.yml
docker/Dockerfile*
docker/*.md
