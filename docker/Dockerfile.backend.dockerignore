release_assets/ai_models/
ai_hub/**/models/
ai_hub/**/*.onnx
ai_hub/**/*.pt
ai_hub/**/*.pkl

# Frontend (ayrı image'da build edilir)
pf/
frontend/

# Python build/venv/cache
myenv/
build/
build_tools/Output/
dist/
buildPEMF/
builds/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Paketler / çıktılar / yedekler
client_paketleri/
outputs/
*.zip

