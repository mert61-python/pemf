<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Guncelleme indirmesi ekran kilidi/arka planda kesilmesin: dataSync on-plan servisi
         (2026-08-27 saha bildirimi). Android 14+ tip-izni ZORUNLU (FOREGROUND_SERVICE_DATA_SYNC);
         POST_NOTIFICATIONS bilerek ISTENMIYOR — izin yoksa bildirim gorunmez, servis yine calisir. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 7'den beri intent'e file:// koymak FileUriExposedException firlatir; APK'yi
         paket yukleyicisine content:// olarak vermek ZORUNLU. KENDI provider'imizi taniyoruz
         (expo-file-system'inkini odunc almak, o paketin ic ayrintisina bagimlilik olurdu). -->
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apkinstaller.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_installer_paths" />
        </provider>
        <service
            android:name="expo.modules.apkinstaller.IndirmeServisi"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
